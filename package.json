{
  "name": "jobgen-ai-chrome-extension",
  "private": true,
  "version": "1.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:extension": "vite build",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "package": "npm run build && python3 scripts/package_release.py",
    "test:browser": "npm run build && node browser-tests/user-flows.mjs",
    "audit:dom": "node scripts/dom-audit.mjs inventory",
    "test:native-public": "npm run build && node browser-tests/native-public.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.2",
    "espree": "10.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
