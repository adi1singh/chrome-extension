{
  "manifest_version": 3,
  "name": "JobGen.AI \u2013 Apply 10\u00d7 Faster with AI",
  "version": "1.3.3",
  "description": "Save jobs, create tailored resumes, and auto-apply to positions 10\u00d7 faster across LinkedIn, Seek, Indeed & major job platforms.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://cn.indeed.com/*",
        "https://www.seek.com.au/*",
        "https://au.seek.com/*",
        "https://jobs.careers.microsoft.com/*",
        "https://*.icims.com/*",
        "https://jobgen.ai/*",
        "https://candidates.jobgen.ai/*",
        "https://*.smartapply.indeed.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": [
        "src/content/content.jsx"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://cn.indeed.com/*",
    "https://jobgen.ai/*",
    "https://candidates.jobgen.ai/*",
    "https://api.jobgen.ai/*",
    "https://jobgen-b2c-api.onrender.com/*",
    "https://jobs.careers.microsoft.com/*",
    "https://*.icims.com/*",
    "https://*.smartapply.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://www.seek.com.au/*",
    "https://au.seek.com/*"
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webNavigation",
    "cookies"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://cn.indeed.com/*",
        "https://www.seek.com.au/*",
        "https://au.seek.com/*",
        "https://jobs.careers.microsoft.com/*",
        "https://*.icims.com/*",
        "https://jobgen.ai/*",
        "https://candidates.jobgen.ai/*",
        "https://*.smartapply.indeed.com/*",
        "https://*.glassdoor.com/*"
      ],
      "resources": [
        "icons/icon48.png",
        "icons/empty.png",
        "icons/cross.png",
        "fonts/Inter-Bold.woff2",
        "fonts/Inter-Light.woff2",
        "fonts/Inter-BlackItalic.woff2",
        "generate_button.png"
      ]
    }
  ]
}
